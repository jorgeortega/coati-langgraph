{
  "name": "coati-langgraph",
  "version": "0.0.0",
  "private": true,
  "description": "The Latitude 10 support coati rebuilt as a LangGraph.js agent on Cloudflare Workers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "index": "node scripts/build-index.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "1.6.0",
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.3",
    "@langchain/openai": "1.7.1",
    "langsmith": "0.11.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.155.0"
  },
  "overrides": {
    "@langchain/langgraph-sdk": "1.12.8"
  }
}
